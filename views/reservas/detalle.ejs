<article class="detalle">
    <p class="etiqueta">
        <%= reserva.sala %>
    </p>
    <h3>
        <%= reserva.estudiante %>
    </h3>
    <p class="personas">
        <%= reserva.personas.toLocaleString("es-AR") %>
    </p>
    <p>
        TURNO: <%= reserva.turno %>
    </p>
    <p>Estado: <%= reserva.estado %>
    </p>
    </p>
    <p><a class="boton" href="/reservas/<%= reserva.id %>/editar">Editar reserva</a></p>
    <p><a href="/reservas/<%= reserva.id %>/estado">Cambiar estado reserva</a></p>
    <p><a href="/reservas/<%= reserva.id %>/eliminar">Eliminar reserva</a></p>
    <a href="/reservas">Volver a Reservas</a>

</article>

